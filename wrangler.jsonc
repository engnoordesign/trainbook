{
  // Cloudflare Workers static assets config. Deploy with:  npx wrangler login   then   npx wrangler deploy
  "name": "trainbook",
  "compatibility_date": "2026-01-01",
  // stamps a build hash into sw.js so each deploy shows the in-app "update ready" prompt
  "build": { "command": "node scripts/stamp.js" },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
